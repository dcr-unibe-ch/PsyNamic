# Settings for generate_and_run.sh on UBELIX

# Billing options
# 1) Preemptible (free, can be interrupted)
BILLING=preemptable
GPU=rtx3090
# 2) Gratis (free)
# BILLING=gratis
# GPU=rtx4090
# 3) Pay-as-you-go (lab project, WCKey: see swckeys)
# BILLING=paygo
# GPU=rtx3090
# PAYGO_WCKEY=

# Slurm
TIME=0-01:00:00     # max. per run
MEM=16GB
CPUS=2

# Output: model checkpoints need ~250 GB, e.g. on scratch (module load Workspace_Home; echo $SCRATCH)
OUTPUT_DIR=model/experiments

# Environment
PYTHON_VERSION=3.12
# PyTorch brings its own CUDA (no CUDA module needed); the CUDA 12.6 build also runs on older drivers (>= 525)
TORCH_VERSION=2.12.1
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126

# Training data
DATA_DIR=data/prepared_data/training_round2
